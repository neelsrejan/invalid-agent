# Copy the values into the Streamlit Community Cloud secrets editor.
# Do not commit secrets.toml. Do not put OPENFDA_API_KEY here.
# The public app reads Postgres and Groq. It does not call openFDA.

DATA_BACKEND = "openfda"
LLM_BACKEND = "groq"
GROQ_API_KEY = ""
GROQ_MODEL = "openai/gpt-oss-20b"

DATABASE_URL_READONLY = ""

JIRA_BASE_URL = ""
JIRA_EMAIL = ""
JIRA_API_TOKEN = ""
JIRA_PROJECT_KEY = "INV"
