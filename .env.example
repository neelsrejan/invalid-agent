# Copy to .env for local overrides. Never commit .env or .env.local.
# CLI commands and Streamlit call load_dotenv(), which reads .env and then
# .env.local (the file `neon deploy` writes). .env.local wins. The process
# environment wins over both. load_settings() does not read either file.
# Pytest sets INVALID_AGENT_SKIP_DOTENV so these files cannot change test results.

# deterministic = templates, no socket. Default and the CI path.
# ollama        = local Ollama. LLM_MODEL is the only local model name.
# groq          = hosted free narrator for the public demo. Needs GROQ_API_KEY.
# llamacpp      = local GGUF path below. Suggested small file is Llama 3.2 1B.
# Default local tag: llama3.1:8b (Meta Llama 3.1 8B).
# Suggested small Ollama tag: llama3.2:1b.
# Hosted Streamlit sets LLM_BACKEND=groq. Cloud has no Ollama.
# Alternatives for Ollama: gemma3 (Gemma 3), phi4 (Phi-4).
LLM_BACKEND=deterministic
OLLAMA_HOST=http://127.0.0.1:11434
LLM_MODEL=llama3.1:8b
LLAMACPP_MODEL_PATH=

# Jira Cloud Free. All three must be set or the run stays a JSON dry run (CI).
# The public demo sets all three. Use a team-managed project so Epic and Task exist.
# JIRA_URL and JIRA_TOKEN are accepted aliases for the first and third variables.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=INV

# Required for the one-time MAUDE extract. Free key, no fee:
# https://open.fda.gov/apis/authentication/
# The extract refuses to start when this is empty. Do not put it in Streamlit.
OPENFDA_API_KEY=

# Public demo narrator. Free tier, no credit card: https://console.groq.com/keys
# Model default is openai/gpt-oss-20b (Llama 3.1 8B Instant left the free tier).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# synthetic = CI and a local run with no secrets. openfda = the public demo.
DATA_BACKEND=synthetic

# Neon admin URL for the one-time load. Include sslmode=require.
# https://neon.tech  (free plan; Railway is not used — its free plan is gone)
DATABASE_URL=
# Password for the invalid_demo_ro role the loader creates.
# Generate a long random value. Do not use a short word:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DEMO_READONLY_PASSWORD=

# real (default) shows the firm name from the public MAUDE report.
# anonymized prints Manufacturer A/B/C instead.
MANUFACTURER_DISPLAY=real
# Printed by the loader. This is the URL the public demo uses.
DATABASE_URL_READONLY=
