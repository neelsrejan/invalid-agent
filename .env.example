# Copy to .env for local overrides. Never commit .env.
# The app reads process environment variables, not this file automatically.

# deterministic = no model, rules and templates (default; CI and hosted demo)
# ollama        = local Ollama, intended model llama3.1:8b
# llamacpp      = local GGUF, intended model Llama 3.2 1B (hosted-demo size)
LLM_BACKEND=deterministic
OLLAMA_HOST=http://127.0.0.1:11434
LLM_MODEL=llama3.1:8b
LLAMACPP_MODEL_PATH=

# Jira Cloud Free is optional. All three must be set or the agent stays in mock mode.
# JIRA_URL and JIRA_TOKEN are accepted aliases for the first and third variables.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=INV

# Optional. openFDA device-event calls work without a key at the anonymous limit.
OPENFDA_API_KEY=
